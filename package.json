{
  "name": "gsb-b",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pixel side-scrolling wave survival action game (React + TypeScript + Canvas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline-build.mjs",
    "build:multi": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=tmp/simulate.mjs --log-level=warning && node tmp/simulate.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
