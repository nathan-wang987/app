{
  "name": "blade-loop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "像素风横版打怪升级网页小游戏 (React + TypeScript + Canvas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
